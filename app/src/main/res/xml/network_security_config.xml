<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, on every Android version (Android 8.x would otherwise allow plain HTTP). System CAs only, no user-installed CAs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
